<?xml version="1.0" encoding="utf-8"?>
<!-- 前台服务/完成通知的小图标：八卦（外圈 + 八向爻划 + 太极）。
     通知小图标只取 alpha 通道（系统灰度化渲染），用纯白绘制；
     任务运行态的「绿色/动画」由 Notification.setColor + 不定进度条承担
     （下拉通知栏可见；AOD 熄屏由系统统一灰度静态渲染，是平台限制）。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 外圈 -->
    <path
        android:pathData="M12,2 a10,10 0 1,1 -0.02,0 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.4"
        android:fillColor="#00000000" />
    <!-- 八向爻划 -->
    <path
        android:pathData="M19.5,12 L21,12 M17.3,17.3 L18.36,18.36 M12,19.5 L12,21 M6.7,17.3 L5.64,18.36 M4.5,12 L3,12 M6.7,6.7 L5.64,5.64 M12,4.5 L12,3 M17.3,6.7 L18.36,5.64"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- 太极外圆 + S 线 -->
    <path
        android:pathData="M12,7 a5,5 0 1,0 0.02,0 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.1"
        android:fillColor="#00000000" />
    <path
        android:pathData="M12,7 a2.5,2.5 0 0 1 0,5 a2.5,2.5 0 0 0 0,5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.1"
        android:fillColor="#00000000" />
    <!-- 太极两眼 -->
    <path
        android:pathData="M12,9.5 m-0.9,0 a0.9,0.9 0 1,0 1.8,0 a0.9,0.9 0 1,0 -1.8,0"
        android:fillColor="#FFFFFFFF" />
    <path
        android:pathData="M12,14.5 m-0.9,0 a0.9,0.9 0 1,0 1.8,0 a0.9,0.9 0 1,0 -1.8,0"
        android:fillColor="#FFFFFFFF" />
